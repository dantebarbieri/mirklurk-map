{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"],
    "strict": true
  },
  "tasks": {
    "dev": "deno run --allow-net=127.0.0.1 --allow-read --allow-write=.uploads --allow-run --allow-env tools/dev.ts",
    "build": "deno run --allow-read --allow-write --allow-run --allow-env tools/build.ts",
    "check": "deno check src/main.ts src/editor/main.ts src/sw.ts server/uploads.ts tools/build.ts tools/dev.ts tools/gamedata.ts tools/itemdata.ts tools/wiki.ts tools/icons.ts tests/",
    "icons": "deno run --allow-read --allow-write=icons --allow-run tools/icons.ts",
    "wiki": "deno run --allow-net=mirklurk.wiki --allow-read=assets/wiki --allow-write=src/wikidata.json,src/wikiart.json,assets/wiki tools/wiki.ts",
    "test": "deno test --allow-read --allow-write --allow-env tests/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "coverage": "deno test --allow-read --allow-write --allow-env --coverage=coverage --clean tests/ && deno coverage coverage --exclude=tests/",
    "ci": "deno fmt --check && deno lint && deno task check && deno task coverage && deno task build"
  },
  "fmt": { "lineWidth": 140 },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "guard-for-in",
        "no-eval",
        "no-external-import",
        "no-inferrable-types",
        "no-non-null-asserted-optional-chain",
        "no-sparse-arrays",
        "no-throw-literal",
        "no-useless-rename",
        "verbatim-module-syntax"
      ]
    }
  },
  "coverage": {
    "thresholds": { "lines": 71, "branches": 85, "functions": 73 }
  },
  "exclude": ["dist/", "coverage/"]
}
